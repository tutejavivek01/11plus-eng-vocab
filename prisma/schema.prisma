// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth (email/password) ----------

model User {
  id              String        @id @default(cuid())
  name            String?
  email           String        @unique
  passwordHash    String
  createdAt       DateTime      @default(now())
  backgroundColor String? // preset key, e.g. "sunrise"; null = default theme
  quizAttempts    QuizAttempt[]
}

// ---------- Word content ----------

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Word {
  id         String     @id @default(cuid())
  word       String
  definition String
  topic      String
  difficulty Difficulty
  synonym    String?
  antonym    String?
  createdAt  DateTime   @default(now())

  @@index([topic])
  @@index([topic, difficulty])
  @@unique([word, topic])
}

// ---------- Quiz attempts ----------

enum QuestionType {
  WORD_TO_DEFINITION
  DEFINITION_TO_WORD
  SYNONYM_ANTONYM
  SPOT_MISSPELLING
}

model SpellingQuestion {
  id            String   @id @default(cuid())
  sentence      String // raw sentence with inline [A]-[E] markers, e.g. "The goverment [A] decided..."
  correctOption String // "A" | "B" | "C" | "D" | "E" ("E" = No error)
  explanation   String
  createdAt     DateTime @default(now())

  @@unique([sentence])
}

model QuizAttempt {
  id        String       @id @default(cuid())
  userId    String
  topic     String
  length    Int
  score     Int
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   QuizAnswer[]

  @@index([userId, createdAt])
  @@index([userId, topic])
}

model QuizAnswer {
  id            String       @id @default(cuid())
  quizAttemptId String
  // Intentionally not a relation: wordId is a soft reference whose target table
  // depends on questionType — Word.id for the vocab question types, SpellingQuestion.id
  // for SPOT_MISSPELLING. Word rows can also be deleted/recreated by prisma/seed.ts, and
  // QuizAnswer already snapshots promptText/correctText/selectedText, so a missing join
  // only loses enrichment, not attempt-review correctness.
  wordId        String
  questionType  QuestionType
  promptText    String
  correctText   String
  selectedText  String
  isCorrect     Boolean
  orderIndex    Int
  explanation   String? // snapshotted explanation text; populated only for SPOT_MISSPELLING answers
  quizAttempt   QuizAttempt  @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)

  @@index([quizAttemptId])
  @@index([wordId])
}
